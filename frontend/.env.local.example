# frontend/.env.local.example
# ==========================
# Copy to `.env.local` (git-ignored) for local development, or set the
# same variables in your hosting provider (e.g. Vercel project settings).
#
# NOTE: `run_all` (scripts/run_all.py) sets NEXT_PUBLIC_API_URL + CORS for
# you automatically, so you only need this file when starting `next dev`
# MANUALLY. Manual runs default to the /backend-api proxy, whose ~30 s
# ceiling drops slow /analyze turns ("Failed to proxy ... socket hang
# up") - set NEXT_PUBLIC_API_URL below to call FastAPI directly instead
# (and add this dashboard's origin to the backend's CORS_ALLOW_ORIGINS).

# Server-side proxy target: the Next.js server forwards /backend-api/*
# to this URL (next.config.mjs), so the browser stays same-origin and no
# CORS setup is needed. Used on Vercel and as the local fallback.
#
# Defaults:
#   local development -> http://127.0.0.1:8001
#   Vercel            -> https://traceai-backend-rg.up.railway.app
#
# Set this explicitly if the backend moves or if the Vercel deployment
# should point to a different backend environment.
BACKEND_INTERNAL_URL=http://127.0.0.1:8001

# Browser-side API base. When set, the dashboard calls the backend
# DIRECTLY instead of through the proxy - required locally for slow
# /analyze turns (see note above). The backend's CORS_ALLOW_ORIGINS must
# then include this dashboard's origin (e.g. http://localhost:3000).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
