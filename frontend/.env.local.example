# frontend/.env.local.example
# ==========================
# Copy to `.env.local` (git-ignored) for local development, or set the
# same variables in your hosting provider (e.g. Vercel project settings).
#
# The Next.js server proxies /backend-api/* to this URL (next.config.mjs),
# so the browser always stays same-origin and no CORS setup is needed.
#
# Leave it unset for the default local backend (http://127.0.0.1:8001).

BACKEND_INTERNAL_URL=http://127.0.0.1:8001

# Only needed if you want the BROWSER to call the API directly instead of
# through the proxy. When set, the backend's CORS_ALLOW_ORIGINS must also
# include this dashboard's origin.
# NEXT_PUBLIC_API_URL=https://your-backend.example
