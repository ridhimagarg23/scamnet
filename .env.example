# ------------------------------------------------------------------
# TraceAI / SCAMNET environment configuration
#
# Copy this file to ".env" and fill in your own values:
#
#     cp .env.example .env
#
# Never commit the real .env file - it is git-ignored.
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# LLM (required for the AI agents) - OpenRouter + NVIDIA NIM
#
# AT LEAST ONE provider key must be set - it powers the
# Investigation / Conversation / Report agents:
#
#   OPENROUTER_API_KEY  (https://openrouter.ai/keys)
#   NVIDIA_NIM_API_KEY  (https://build.nvidia.com -> Get API Key)
#
# HOW A MESSAGE IS PROCESSED (fixed - there is no picker in the UI):
#
#   1. the pasted scammer message goes to OPENROUTER (LLM_MODEL) first;
#   2. if OpenRouter has NOT replied within OPENROUTER_DEADLINE
#      (15 s by default) the call is abandoned and the NVIDIA stage
#      takes over;
#   3. NVIDIA stage = nvidia/nemotron-3-ultra-550b-a55b first, and only
#      if that one fails too -> nvidia/nemotron-3.5-lightning-30b-a3b.
#
# So: set OPENROUTER_API_KEY for the normal path and NVIDIA_NIM_API_KEY
# to get the nemotron fallback. Only one key? The configured provider
# is used on its own (no fallback hop).
#
# Without any key the server still boots and serves the dashboard +
# integrations, but POST /analyze answers HTTP 503 "llm_not_configured"
# and GET /health reports "degraded" - so you can verify an
# external-app setup first.
#
# Set TRACEAI_STRICT_CONFIG=1 to go back to refusing to start at all
# when the keys are missing.
# ------------------------------------------------------------------
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=

# Optional: which provider is ACTIVE when OpenRouter is not usable.
# The request flow always starts on OpenRouter, so leave this empty
# unless you deliberately run NVIDIA-only (POST /api/llm/select can
# still switch it at runtime, but the dashboard no longer exposes it).
LLM_PROVIDER=

# Optional: the OpenRouter model every message starts on.
LLM_MODEL=qwen/qwen3-32b

# Optional: NVIDIA stage model. Leave EMPTY (or set it to the ultra id)
# so the fallback stage runs nemotron-3-ultra first, then 3.5 lightning.
NVIDIA_NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Optional: gateway roots (override only for a self-hosted gateway).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: how long OpenRouter may take before the NVIDIA stage
# replaces it (seconds; 0 = wait for the timeout below instead).
# LLM_PRIMARY_DEADLINE is a synonym for the same value.
OPENROUTER_DEADLINE=15

# Optional: extra spare models tried IN ORDER after the ones above.
# The NVIDIA stage ALWAYS contains the two nemotron models (ultra ->
# lightning) whatever these hold; extras are appended after them.
# OPENROUTER_FALLBACK_MODELS=
# NVIDIA_NIM_FALLBACK_MODELS=

# Optional: 1 (default) lets a failing provider fall back to the OTHER
# provider's models when its key is configured; 0 disables that hop.
# Keep it on - it is what makes the OpenRouter -> NVIDIA switch work.
# LLM_CROSS_PROVIDER_FALLBACK=1

# Optional: per-request timeouts in seconds. Defaults: 90 (OpenRouter),
# 45 (NVIDIA NIM - the 550B model needs a little room).
# LLM_TIMEOUT is the shared shorthand.
# OPENROUTER_TIMEOUT=90
# NVIDIA_NIM_TIMEOUT=45

# Optional: extra comma-separated model ids appended to the dashboard
# picker (for brand-new models missing from the curated catalog).
# The easier path is pasting them into llm_models.json at the repo root.
# OPENROUTER_MODELS=
# NVIDIA_NIM_MODELS=

# Optional: fail hard at startup when OPENROUTER_API_KEY is missing
# (1/true/yes/on). Default: off - log a warning and serve a degraded
# /health instead.
TRACEAI_STRICT_CONFIG=

# ------------------------------------------------------------------
# CORS (optional)
#
# Comma-separated browser origins allowed to call the API CROSS-ORIGIN.
# The bundled Next.js dashboard does NOT need this: it proxies
# same-origin through /backend-api (see frontend/next.config.mjs).
# Defaults: http://localhost:3000, http://127.0.0.1:3000 and
# https://trace-ai-phi.vercel.app
# ------------------------------------------------------------------
CORS_ALLOW_ORIGINS=

# ------------------------------------------------------------------
# SCAMNET external-app integrations (all OPTIONAL)
#
# These values are read SERVER-SIDE ONLY by the integration layer
# (integrations/) and reported as honest status by GET /api/integrations.
# Leave them empty until you have real credentials - an empty value
# keeps the app in the "not_configured" state (the dashboard will never
# claim a fake connection).
#
# SECURITY: never commit the filled-in .env, never paste tokens into
# frontend code, and never expose them through API responses.
# Restart the backend after editing this file.
# ------------------------------------------------------------------

# --- Telegram (communication & intelligence gathering) ---
# Bot token issued by @BotFather (e.g. for @scamnet_intel_bot).
# Used SERVER-SIDE ONLY for real Bot API calls (getMe / getUpdates /
# sendMessage via integrations/telegram/client.py). Restart the
# backend after changing it, then verify with:
#   POST /api/integrations/telegram/connect
TELEGRAM_BOT_TOKEN=
# Optional Bot API root (default: https://api.telegram.org).
# Point it at scripts/telegram_simulator.py to test the whole loop
# locally without a real bot (see README -> "Testing the bot").
TELEGRAM_API_BASE=
# Start the reply loop automatically (default: 1 = yes).
#   * at boot, when TELEGRAM_BOT_TOKEN works (getMe succeeds);
#   * immediately after POST /api/integrations/telegram/connect.
# Set to 0 only when another service already owns the getUpdates
# cursor for this bot - otherwise the bot looks mute to the scammer.
TELEGRAM_AUTO_START_WORKER=1

# --- Google credentials (Drive / Sheets / Gmail) ---
# One credentials JSON can serve all three Google apps. Point each
# provider at its own file, or set GOOGLE_CREDENTIALS_FILE once and
# leave the provider-specific values empty.
#
# Supported credential types:
#   * service account  {"type": "service_account", ...}   (Drive, Sheets)
#   * authorized user  {"type": "authorized_user", ...}   (Drive, Sheets, Gmail)
# Gmail requires an authorized-user file (refresh token); service
# accounts need Google Workspace domain-wide delegation.
#
# Keep the JSON files OUT of git - see .gitignore (credentials/,
# *service_account*.json, *token*.json are ignored).
GOOGLE_CREDENTIALS_FILE=

# --- Google Sheets (live investigation evidence) ---
# Path to the service-account / OAuth JSON key file on the server.
GOOGLE_SHEETS_CREDENTIALS_FILE=
# Optional: existing spreadsheet id. When empty, SCAMNET CREATES a
# spreadsheet named "SCAMNET Investigation Evidence" on first connect
# (and reports its URL through GET /api/integrations).
GOOGLE_SHEETS_SPREADSHEET_ID=
# Optional: worksheet (tab) evidence rows are written to (default: Evidence)
GOOGLE_SHEETS_WORKSHEET=

# --- Google Drive (investigation reports) ---
# Path to the service-account / OAuth JSON key file on the server.
GOOGLE_DRIVE_CREDENTIALS_FILE=
# Optional: destination folder id for generated report files. With a
# service account, share this folder with the account's client_email.
GOOGLE_DRIVE_FOLDER_ID=

# --- Gmail (evidence inbox & report delivery) ---
# Path to an authorized-user (OAuth refresh-token) JSON key file.
GOOGLE_GMAIL_CREDENTIALS_FILE=
