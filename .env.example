# ------------------------------------------------------------------
# TraceAI environment configuration
#
# Copy this file to ".env" and fill in your own values:
#
#     cp .env.example .env
#
# Never commit the real .env file - it is git-ignored.
# ------------------------------------------------------------------

# Required: OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional: LLM model slug served via OpenRouter
# (default: qwen/qwen3-32b)
LLM_MODEL=qwen/qwen3-32b

# ------------------------------------------------------------------
# SCAMNET external-app integrations (all OPTIONAL)
#
# These values are read SERVER-SIDE ONLY by the integration layer
# (integrations/) and reported as honest status by GET /api/integrations.
# Leave them empty until you have real credentials - an empty value
# keeps the app in the "not_configured" state (the dashboard will never
# claim a fake connection).
#
# SECURITY: never commit the filled-in .env, never paste tokens into
# frontend code, and never expose them through API responses.
# Restart the backend after editing this file.
# ------------------------------------------------------------------

# --- Telegram (communication & intelligence gathering) ---
# Bot token issued by @BotFather (e.g. for @scamnet_intel_bot).
# Used SERVER-SIDE ONLY for real Bot API calls (getMe / getUpdates /
# sendMessage via integrations/telegram/client.py). Restart the
# backend after changing it, then verify with:
#   POST /api/integrations/telegram/connect
TELEGRAM_BOT_TOKEN=
# Optional Bot API root (default: https://api.telegram.org)
TELEGRAM_API_BASE=

# --- Google Sheets (live investigation evidence) ---
# Server-side path to the service-account / OAuth JSON key file
# (keep the file itself OUT of git - see .gitignore). Real Sheets
# auth flow is not implemented yet (see integrations/google_sheets/client.py).
GOOGLE_SHEETS_CREDENTIALS_FILE=
# Optional: target spreadsheet id (created per investigation if unset)
GOOGLE_SHEETS_SPREADSHEET_ID=

# --- Google Drive (investigation reports) ---
# Server-side path to the service-account / OAuth JSON key file
# (keep the file itself OUT of git - see .gitignore). Real Drive
# auth flow is not implemented yet (see integrations/google_drive/client.py).
GOOGLE_DRIVE_CREDENTIALS_FILE=
# Optional: destination folder id for generated report files
GOOGLE_DRIVE_FOLDER_ID=
